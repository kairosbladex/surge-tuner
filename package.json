{
  "name": "proxy-tuner",
  "version": "0.3.0",
  "private": true,
  "description": "Proxy Tuner — 跨平台代理配置自动生成 & Agent-to-Agent 工具包。根据VPN地址自动解析节点、生成路由规则、安装去广告插件。",
  "scripts": {
    "generate": "node scripts/surge-config-generator.js",
    "generate:surge": "node scripts/surge-config-generator.js",
    "generate:loon": "node scripts/loon-config-generator.js",
    "generate:qx": "node scripts/quantumultx-config-generator.js",
    "generate:clash": "node scripts/clash-config-generator.js",
    "convert": "node scripts/cross-platform-converter.js",
    "adblock": "node scripts/adblock-installer.js",
    "prefs": "node scripts/user-preference-store.js",
    "quick-start": "node scripts/quick-start-server.js",
    "start:a2a": "node scripts/a2a-server.js",
    "validate": "node scripts/surge-config-validator.js --all",
    "test": "node --test tests/*.test.js",
    "check": "npm test && npm run validate"
  },
  "engines": {
    "node": ">=20"
  }
}
