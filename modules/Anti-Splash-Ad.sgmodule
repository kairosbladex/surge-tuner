#!name=Anti-Splash-Ad
#!desc=🚀 开屏广告拦截模块 — 拦截穿山甲/广点通/百度等主流 SDK 开屏广告
#!system=iOS
#!requirement=CORE_VERSION>=20

[MITM]
hostname = -*.apple.com, -*.icloud.com, -*.mzstatic.com, -*.crashlytics.com, -*.digicert.com, -*.apple-dns.net, -*.aaplimg.com, *.pangle.io, *.pangleglobal.com, *.pangolin-sdk-toutiao.com, *.byteoversea.com, *.byteoversea.net, *.pglstatp.com, *.pgdt.bytedance.com, *.ad.oceanengine.com, *.gdt.qq.com, *.e.qq.com, *.ia.gdt.qq.com, *.btrace.gdt.qq.com, *.ad.qq.com, *.umeng.com, *.cpro.baidu.com, *.nsclick.baidu.com, *.e.baidu.com, *.mssp.baidu.com, *.union.baidu.com, *.mobads.baidu.com, *.admob.com, *.doubleclick.net, *.googlesyndication.com, *.googleadservices.com, *.applovin.com, *.vungle.com, *.unityads.unity3d.com, *.adcolony.com, *.mintegral.com, *.adxmi.com, *.reyun.com, *.talkingdata.com, *.snssdk.com, *.amemv.com, *.ibyted.com
skip-server-cert-verify = true

[Rule]
; 开屏广告域名 — 直接拒绝
RULE-SET,rulesets/SplashAd.list, REJECT
; 需要脚本处理的域名
RULE-SET,rulesets/AntiAd-Script.list, REJECT-TINYGIF

[Script]
; 开屏广告响应体清洗（请将脚本文件放入 Surge 的配置文件目录）
http-response ^https?://.* requires-body = true script-path = scripts/remove-splash-ad.js
