#!name=Anti-Tracking
#!desc=🔒 隐私追踪拦截模块 — 拦截友盟/热云/TalkingData/AppsFlyer 等统计 SDK
#!system=iOS
#!requirement=CORE_VERSION>=20

[MITM]
hostname = -*.apple.com, -*.icloud.com, *.umeng.com, *.umtrack.com, *.ulogs.umeng.com, *.reyun.com, *.reyun.net, *.talkingdata.com, *.talkingdata.net, *.appsflyer.com, *.appsflyer.net, *.adjust.com, *.adjust.net, *.adjust.io, *.getui.com, *.getui.net, *.jpush.cn, *.jpush.io, *.jiguang.cn, *.growingio.com, *.growingio.net, *.sensorsdata.com, *.sensorsdata.cn, *.google-analytics.com, *.googletagmanager.com, *.firebaseio.com, *.mixpanel.com, *.segment.com, *.amplitude.com, *.flurry.com
skip-server-cert-verify = true
enable = true

[Rule]
; 追踪域名 — 直接拒绝
RULE-SET, Tracking.list, REJECT

[Script]
; 请求端 — 移除追踪参数和 Header
http-request ^https?://.* script-path = scripts/anti-tracking.js
; 响应端 — 移除响应中的追踪信息（如需修改 body 可加 requires-body = true）
http-response ^https?://.* script-path = scripts/anti-tracking.js

[Header Rewrite]
; 移除 DNT（Do Not Track）— 有些网站会忽略
^https?://.* request-header X-Do-Not-Track = 1
^https?://.* request-header DNT = 1
